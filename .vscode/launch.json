{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "EngineApplication",
            "request": "launch",
            "mainClass": "com.core.engine.EngineApplication",
            "projectName": "engine"
        },
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}"
        },
        {
            "type": "java",
            "name": "IngressServiceApplication",
            "request": "launch",
            "mainClass": "com.orderlifecycle.ingress_service.IngressServiceApplication",
            "projectName": "ingress-service"
        }
    ],
    "compounds": [
        {
            "name": "Run Both Services",
            "configurations": [
                "EngineApplication",
                "IngressServiceApplication"
            ]
        }
    ]
}
